/* ChronoFace light theme — premium desktop shell */

* {
  font-family: "Segoe UI Variable", "Segoe UI", Inter, system-ui, sans-serif;
  color: #1F2937;
}

QMainWindow, QDialog {
  background: #F7F8FB;
}

QMenuBar {
  background: #FFFFFF;
  border-bottom: 1px solid #E5E7EB;
  padding: 2px 8px;
}

QMenuBar::item {
  background: transparent;
  padding: 6px 10px;
  border-radius: 6px;
}

QMenuBar::item:selected {
  background: #EEF2FF;
  color: #1F2937;
}

QMenu {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  padding: 6px;
}

QMenu::item {
  padding: 8px 24px 8px 12px;
  border-radius: 6px;
}

QMenu::item:selected {
  background: #EEF2FF;
}

QStatusBar {
  background: #FFFFFF;
  border-top: 1px solid #E5E7EB;
  color: #6B7280;
}

QToolTip {
  background: #0F172A;
  color: #FFFFFF;
  border: none;
  padding: 6px 10px;
  border-radius: 6px;
}

/* Buttons */
QPushButton {
  font-weight: 600;
  padding: 8px 16px;
  border-radius: 8px;
  background: #FFFFFF;
  color: #1F2937;
  border: 1px solid #E5E7EB;
}

QPushButton:hover {
  background: #F9FAFB;
  border-color: #D1D5DB;
}

QPushButton:pressed {
  background: #F3F4F6;
}

QPushButton:disabled {
  color: #9CA3AF;
  background: #F3F4F6;
  border-color: #E5E7EB;
}

QPushButton#primaryButton {
  background: #2F6BFF;
  color: #FFFFFF;
  border: none;
}

QPushButton#primaryButton:hover {
  background: #2558E0;
}

QPushButton#primaryButton:pressed {
  background: #1E4AC4;
}

QPushButton#primaryButton:disabled {
  background: #C7D2FE;
  color: #EEF2FF;
}

QPushButton#aiAnalyzeButton {
  padding: 9px 18px;
  border-radius: 10px;
  border: none;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 0.2px;
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #2F6BFF,
    stop: 0.55 #7C5CFF,
    stop: 1 #F472B6
  );
}

QPushButton#aiAnalyzeButton:hover {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #2558E0,
    stop: 0.55 #6D4AE8,
    stop: 1 #EC4899
  );
}

QPushButton#aiAnalyzeButton:pressed {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #1E4AC4,
    stop: 0.55 #5B3BD1,
    stop: 1 #DB2777
  );
}

QPushButton#aiAnalyzeButton:disabled {
  background: qlineargradient(
    x1: 0, y1: 0, x2: 1, y2: 0,
    stop: 0 #C7D2FE,
    stop: 1 #FBCFE8
  );
  color: #EEF2FF;
}

QPushButton#dangerButton {
  background: #FFFFFF;
  color: #DC2626;
  border: 1px solid #FECACA;
}

QPushButton#dangerButton:hover {
  background: #FEF2F2;
  border-color: #FCA5A5;
}

QPushButton#ghostButton {
  background: transparent;
  border: 1px solid #E5E7EB;
}

QPushButton#rotatorButton:checked {
  background: #2F6BFF;
  color: #FFFFFF;
  border: 1px solid #2F6BFF;
}

QPushButton#rotatorButton:checked:hover {
  background: #2558E0;
  border-color: #2558E0;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  padding: 8px 10px;
  min-height: 18px;
  selection-background-color: #DBEAFE;
}

/* Compact combo aligned with toolbar QPushButton height */
QComboBox#toolbarCombo {
  padding: 2px 10px;
  min-height: 0px;
  max-height: 32px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QDateEdit:focus {
  border: 1px solid #2F6BFF;
}

QComboBox::drop-down {
  border: none;
  width: 28px;
}

QComboBox QAbstractItemView {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  selection-background-color: #EEF2FF;
  outline: none;
}

/* Checkboxes — rounded to match input fields */
QCheckBox {
  spacing: 8px;
}

QCheckBox::indicator {
  width: 18px;
  height: 18px;
  border: 1px solid #D1D5DB;
  border-radius: 4px;
  background: #FFFFFF;
}

QCheckBox::indicator:hover {
  border-color: #2F6BFF;
}

QCheckBox::indicator:checked {
  background: #2F6BFF;
  border-color: #2F6BFF;
  image: url("__CHECK_ICON__");
}

QCheckBox::indicator:disabled {
  background: #F3F4F6;
  border-color: #E5E7EB;
}

/* Cards / frames */
QFrame#card, QFrame#metricCard {
  background: #FFFFFF;
  border: 1px solid #EEF0F4;
  border-radius: 12px;
}

QFrame#metricCard:hover {
  border-color: #C7D2FE;
}

QFrame#metricCard[selected="true"] {
  border-color: #2F6BFF;
  background: #F8FAFF;
}

/* Inspector tray — same 12px radius as the preview wrap inside */
QFrame#inspectorCard {
  background: #F3F4F6;
  border: 1px solid #EEF0F4;
  border-radius: 12px;
}

QLabel#mutedLabel {
  color: #6B7280;
}

QLabel#pathLinkLabel {
  color: #2F6BFF;
  text-decoration: underline;
}

QLabel#titleLabel {
  font-size: 22px;
  font-weight: 700;
  color: #1F2937;
}

QLabel#sectionTitle {
  font-size: 15px;
  font-weight: 700;
  color: #1F2937;
}

QLabel#metricValue {
  font-size: 24px;
  font-weight: 700;
  color: #1F2937;
}

QLabel#metricLabel {
  font-size: 12px;
  color: #6B7280;
}

QProgressBar {
  background: #E5E7EB;
  border: none;
  border-radius: 6px;
  text-align: center;
  color: #1F2937;
  min-height: 12px;
  max-height: 12px;
}

/* Modal analyze/install loaders — room for percent text. */
QProgressBar#dialogProgress {
  min-height: 22px;
  max-height: 22px;
  border-radius: 8px;
}

QProgressBar::chunk {
  background: #2F6BFF;
  border-radius: 6px;
}

QProgressBar#dialogProgress::chunk {
  border-radius: 8px;
}

QProgressBar#successBar::chunk {
  background: #16A34A;
}

QSplitter::handle {
  background: transparent;
}

/* Dashboard sets its own handle width; keep global handle thin. */
QSplitter::handle:horizontal {
  width: 4px;
}

QListWidget {
  background: #FFFFFF;
  border: 1px solid #EEF0F4;
  border-radius: 12px;
  outline: none;
  padding: 8px;
}

QScrollArea {
  background: transparent;
  border: none;
}

/* Themed modal cards (MessageDialog / ProgressDialog / ChoiceDialog) */
QFrame#messageCard {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 16px;
}

QPushButton#ghostButton:hover {
  background: #F3F4F6;
}
